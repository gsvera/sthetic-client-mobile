{
  "expo": {
    "name": "Meredith Aesthetic",
    "slug": "sthetic--client-mobile",
    "version": "1.0.8",
    "orientation": "default",
    "icon": "./assets/images/meredith-aesthetic-logo-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta aplicación necesita acceder a tu ubicación para mostrar tu posición en el mapa."
      },
      "bundleIdentifier": "com.abasotech.meredithcare",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/meredith-aesthetic-logo-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.abasotech.meredithcare",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "wa.me"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/meredith-aesthetic-logo-icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/meredith-aesthetic-logo-icon.png"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/meredith-aesthetic-logo-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-web-browser",
      "expo-font",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "141ef2b0-a37b-4383-832d-ec23717baf56"
      }
    }
  }
}
