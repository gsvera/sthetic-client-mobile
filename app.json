{
  "expo": {
    "name": "MerAesthetic",
    "slug": "sthetic--client-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/meraesthetic-logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta aplicación necesita acceder a tu ubicación para mostrar tu posición en el mapa."
      },
      "bundleIdentifier": "com.abasotech.meredithcare",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/meraesthetic-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.abasotech.meredithcare"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/meraesthetic-logo.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/meraesthetic-logo.png"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/meraesthetic-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "141ef2b0-a37b-4383-832d-ec23717baf56"
      }
    }
  }
}
